# Vibe app build configuration. Copy to `.env` (git-ignored) and build with
#   flutter run --dart-define-from-file=.env
#   flutter build apk --release --dart-define-from-file=.env
# Every key is optional: an integration without its keys is hidden (or, in
# debug builds, replaced by a dev stand-in). Nothing here is a secret — all
# of it ships inside the app. Server secrets live in the backend's env.
# Where to get each value: INTEGRATIONS_APP.md.

# ── Server ────────────────────────────────────────────────────────────────
# Without it the app runs fully offline on the built-in mock.
VIBE_API=https://api.example.com
# Store builds only offer that store's billing (and send X-App-Store):
# play | appstore | (empty for direct/side-loaded builds)
# VIBE_STORE_BUILD=play

# ── Google Sign-In ────────────────────────────────────────────────────────
# Web OAuth client id (the ID token audience; also in the server's GOOGLE_CLIENT_IDS)
# GOOGLE_SERVER_CLIENT_ID=123456789012-xxxxxxxx.apps.googleusercontent.com
# iOS OAuth client id (iOS builds; its reversed form goes in ios/Flutter/Integrations.xcconfig)
# GOOGLE_IOS_CLIENT_ID=123456789012-yyyyyyyy.apps.googleusercontent.com

# ── Sign in with Apple (Android web flow; iOS needs only the capability) ──
# APPLE_SERVICE_ID=com.pingcrood.vibe.signin
# APPLE_REDIRECT_URI=https://api.example.com/v1/auth/apple/callback

# ── Facebook Login (also read by Gradle for the manifest; iOS: xcconfig) ──
# FACEBOOK_APP_ID=123456789012345
# FACEBOOK_CLIENT_TOKEN=0123456789abcdef0123456789abcdef

# ── Firebase Cloud Messaging (push). No google-services.json needed. ─────
# FIREBASE_API_KEY=AIza...
# FIREBASE_PROJECT_ID=vibe-prod
# FIREBASE_MESSAGING_SENDER_ID=123456789012
# FIREBASE_ANDROID_APP_ID=1:123456789012:android:abcdef0123456789
# FIREBASE_IOS_APP_ID=1:123456789012:ios:abcdef0123456789
# FIREBASE_IOS_BUNDLE_ID=com.pingcrood.vibeApp
# FIREBASE_STORAGE_BUCKET=vibe-prod.appspot.com

# ── AdMob rewarded ads ────────────────────────────────────────────────────
# Rewarded ad units. Debug builds fall back to Google's test units.
# ADMOB_REWARDED_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
# ADMOB_REWARDED_IOS=ca-app-pub-XXXXXXXXXXXXXXXX/NNNNNNNNNN
# AdMob *app* id for the Android manifest (read by Gradle; default: Google's test app id).
# iOS: ADMOB_APP_ID_IOS in ios/Flutter/Integrations.xcconfig.
# ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXXXXXXXXXXXXX~NNNNNNNNNN
