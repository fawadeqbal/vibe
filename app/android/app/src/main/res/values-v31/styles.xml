<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ draws its own splash from the launcher icon; give it the app's dark background. -->
<resources>
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/vibe_bg</item>
        <!-- No launcher icon on the system splash: it is just the dark background, so the animated splash is the first thing you see. -->
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_blank</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/vibe_bg</item>
    </style>
</resources>
