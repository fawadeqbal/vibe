<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- The incoming-call screen: shown over the lock screen by the call
             notification's full-screen intent, in its own task, so Vibe itself
             only opens when the call is answered. -->
        <activity
            android:name=".IncomingCallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTop"
            android:taskAffinity="dev.fawadiqbal.vibe.calls.incoming"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <!-- Decline on the call notification (heads-up banner). -->
        <receiver
            android:name=".CallActionReceiver"
            android:exported="false" />
    </application>
</manifest>
