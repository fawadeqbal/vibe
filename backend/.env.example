# ════════════════════════════════════════════════════════════════════════════
#  Vibe API — example settings. Copy to .env and fill in.
#  Full guide to the integration keys: INTEGRATIONS.md
# ════════════════════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────────────────
# The basics every environment needs.
#
# development | test | production (production enables the safety checks).
NODE_ENV=development
# Port the API listens on inside its container/host.
PORT=3000
# Public address of the API; used to build webhook, return and media URLs.
PUBLIC_URL=http://localhost:3000
# Comma-separated browser origins allowed to call the API (* = any).
CORS_ORIGINS=*
# PostgreSQL connection string.
DATABASE_URL=postgresql://vibe:vibe@localhost:5432/vibe?schema=public
# Redis connection string (queues, locks, presence, caches).
REDIS_URL=redis://localhost:6379
# Daily rewards/limits reset at local midnight of this offset (Pakistan = 300).
BUSINESS_TZ_OFFSET_MINUTES=300
# fatal | error | warn | info | debug | trace.
LOG_LEVEL=info
# Serve the API docs at /docs (true/false).
SWAGGER_ENABLED=true
# Requests per minute per IP/user before 429.
RATE_LIMIT_PER_MINUTE=120

# ── App sign-in tokens ──────────────────────────────────────────────────────
# Secrets: at least 32 random characters (openssl rand -base64 48). Real values are generated by deploy.ps1.
#
# Signs app access tokens. Changing it signs everyone out.
JWT_ACCESS_SECRET=FfjujyDPV9BlkMeFOlZbWZ0Tuxcq5+n4AO0nNs2dOBDFIqd9K3wpUywaEfWvwTk+
# How long an access token lives (seconds).
JWT_ACCESS_TTL_SECONDS=900
# How long a login lasts without opening the app (days).
REFRESH_TTL_DAYS=30
# Seals payout account numbers and provider refresh tokens. Set once, never change. Required when payouts are live.
DATA_ENCRYPTION_KEY=

# ── Admin panel (staff) ─────────────────────────────────────────────────────
# Signs staff tokens; must differ from JWT_ACCESS_SECRET.
JWT_STAFF_SECRET=CEnP0ZQo+sC8XquL/k9zZArCDHpur9e0kwKIaZQdK7hs0rueS5Ryocot+baJ7E3M
# Staff access token lifetime (seconds).
STAFF_ACCESS_TTL_SECONDS=600
# Staff stay signed in this long (hours).
STAFF_SESSION_HOURS=12
# Wrong passwords before a staff account is locked.
STAFF_LOGIN_MAX_FAILURES=5
# How long a locked staff account waits (minutes).
STAFF_LOGIN_LOCK_MINUTES=15
# Name shown in authenticator apps.
STAFF_TOTP_ISSUER=Vibe Admin
# First owner account, created by `npm run db:seed`.
ADMIN_EMAIL=owner@vibe.local
# Its first password (change it after signing in).
ADMIN_PASSWORD=ChangeMe-2026

# ── E-mail and sign-in codes ────────────────────────────────────────────────
# Sign-in codes are e-mailed. Gmail: your address + a 16-character App Password (Google Account -> Security -> App passwords).
#
# console = print codes to the log (dev) | smtp = really send.
MAIL_PROVIDER=smtp         # console | smtp
# SMTP server (smtp.gmail.com for Gmail).
SMTP_HOST=smtp.gmail.com
# 465 (TLS) or 587 (STARTTLS).
SMTP_PORT=465
# true for 465, false for 587.
SMTP_SECURE=true              # true for 465, false for 587
# SMTP login (your Gmail address).
SMTP_USER=fawadeqbal@gmail.com
# SMTP password / Gmail App Password. Never commit a real one.
SMTP_PASS=wbfgfdbdoqheascp                    # 16-character Gmail App Password (never commit a real one)
# Sender people see, e.g. Vibe <you@gmail.com>.
MAIL_FROM=Vibe <fawadeqbal@gmail.com>
# How long a sign-in code works (seconds).
OTP_TTL_SECONDS=600           # codes last 10 minutes
# Dev only: every code is this (ignored in production).
# OTP_FIXED_CODE=1234           # dev only: every code is 1234 (ignored in production)

# ── Social sign-in (Google, Apple, Facebook) ────────────────────────────────
# Integration switches: dev = built-in test stand-in (no keys, no real money/messages),
# See backend/INTEGRATIONS.md for where to get each key.
#
# dev (tokens dev:<id>) | live | auto.
SOCIAL_VERIFIER=dev           # dev (tokens "dev:<id>[:<name>]") | live | auto
# Google OAuth client ids, comma-separated: Web (the app's serverClientId) + iOS.
GOOGLE_CLIENT_IDS=            # OAuth client ids, comma-separated: Web (the app's serverClientId) + iOS
# Apple bundle id (iOS) + Services ID (Android), comma-separated.
APPLE_CLIENT_IDS=             # bundle id (iOS) + Services ID (Android web flow), comma-separated
# Apple team id (for revoking Apple sign-in when an account is deleted).
APPLE_TEAM_ID=                # Sign in with Apple key: lets us revoke tokens when an account is deleted
# Sign in with Apple key id.
APPLE_SIGNIN_KEY_ID=
# Sign in with Apple key (.p8): literal with \n, base64:..., or file:/path.
APPLE_SIGNIN_PRIVATE_KEY=     # .p8 contents (\n escapes), base64:…, or file:/path
# Android app id (Sign in with Apple on Android returns to it).
ANDROID_PACKAGE_NAME=com.pingcrood.vibe_app
# Meta for Developers app id.
FACEBOOK_APP_ID=
# Meta app secret.
FACEBOOK_APP_SECRET=

# ── Payments (money in) ─────────────────────────────────────────────────────
# Integration switches: dev = built-in test stand-in (no keys, no real money/messages),
# live = the real provider (anything without keys is turned off),
# auto = live where keys are set, dev for the rest (off in production).
# Admin panel -> Operations -> Integrations shows what is live and which keys are missing.
#
# dev | live | auto for all payment methods.
PAYMENTS_PROVIDER=dev         # dev | live | auto
# Dev only: decline every Nth charge to test failures (0 = never).
DEV_PAYMENTS_FAIL_EVERY=0     # dev: decline every Nth charge to test failures
# Signs the generic /webhooks/payments callback and dev card webhooks.
PAYMENT_WEBHOOK_SECRET=change-me
# Unfinished wallet/card checkouts expire after this many minutes.
PAYMENT_CHECKOUT_TTL_MINUTES=30
# Where hosted payment pages send people back (the app's deep link).
PAYMENT_RETURN_URL=vibe://payment-return

# ── Payments: Google Play Billing ───────────────────────────────────────────
# Play Console service account with View financial data + Manage orders.
#
# Android package name, e.g. com.pingcrood.vibe_app.
GOOGLE_PLAY_PACKAGE=          # e.g. com.pingcrood.vibe_app
# Service account key JSON: literal, base64:..., or file:/path.
GOOGLE_SERVICE_ACCOUNT_JSON=  # service account key JSON (literal, base64:…, or file:/path)
# Pub/Sub push audience (= https://<api>/v1/webhooks/google-play); turns on token checks.
GOOGLE_PLAY_RTDN_AUDIENCE=    # Pub/Sub push subscription audience (enables token checks on RTDN)
# Service account e-mail the Pub/Sub push signs with.
GOOGLE_PLAY_RTDN_SERVICE_ACCOUNT=

# ── Payments: App Store ─────────────────────────────────────────────────────
# App Store Connect -> Users and Access -> Integrations -> In-App Purchase key.
#
# Issuer id of the In-App Purchase key.
APPLE_ISSUER_ID=
# In-App Purchase key id.
APPLE_KEY_ID=
# In-App Purchase key (.p8): literal with \n, base64:..., or file:/path.
APPLE_PRIVATE_KEY=            # In-App Purchase key (.p8)
# iOS bundle id.
APPLE_BUNDLE_ID=
# Numeric app id (App Store Connect -> App Information).
APPLE_APP_APPLE_ID=           # numeric app id (App Store Connect → App Information)
# auto | production | sandbox.
APPLE_IAP_ENVIRONMENT=auto    # auto | production | sandbox

# ── Payments: JazzCash ──────────────────────────────────────────────────────
# JazzCash merchant portal. Return/IPN URL: https://<api>/v1/webhooks/jazzcash
#
# sandbox | production.
JAZZCASH_ENV=sandbox          # sandbox | production
# Merchant ID.
JAZZCASH_MERCHANT_ID=
# Merchant password.
JAZZCASH_PASSWORD=
# Integrity salt (signs pp_SecureHash).
JAZZCASH_INTEGRITY_SALT=

# ── Payments: Easypaisa ─────────────────────────────────────────────────────
# Easypay merchant account. IPN URL: https://<api>/v1/webhooks/easypaisa
#
# sandbox | production.
EASYPAISA_ENV=sandbox
# Store id.
EASYPAISA_STORE_ID=
# API username.
EASYPAISA_USERNAME=
# API password.
EASYPAISA_PASSWORD=
# Hash key (hosted checkout).
EASYPAISA_HASH_KEY=
# Your merchant Easypaisa account number (needed by the status inquiry).
EASYPAISA_ACCOUNT_NUM=

# ── Payments: card gateway ──────────────────────────────────────────────────
# Hosted checkout. dev = built-in test page with Pay / Decline. Webhook: https://<api>/v1/webhooks/card/<name>
#
# dev, or the name of a real gateway added in card/gateways/.
CARD_GATEWAY=dev
# Gateway API key.
CARD_GATEWAY_API_KEY=
# Gateway secret key.
CARD_GATEWAY_SECRET=
# Gateway webhook signing secret.
CARD_GATEWAY_WEBHOOK_SECRET=
# Gateway API base URL (sandbox or live).
CARD_GATEWAY_BASE_URL=

# ── Payouts (gems cash-out) ─────────────────────────────────────────────────
# Integration switches: dev = built-in test stand-in (no keys, no real money/messages),
# Bank payouts are always staff batches (Finance -> Payout batches); no keys.
#
# dev | live | auto for JazzCash/Easypaisa payouts.
PAYOUTS_PROVIDER=dev          # dev | live | auto  (bank payouts are always staff batches)
# JazzCash disbursement API base URL (from the disbursement agreement).
JAZZCASH_DISBURSE_BASE_URL=
# JazzCash disbursement client id.
JAZZCASH_DISBURSE_CLIENT_ID=
# JazzCash disbursement client secret.
JAZZCASH_DISBURSE_CLIENT_SECRET=
# JazzCash disbursement username.
JAZZCASH_DISBURSE_USERNAME=
# JazzCash disbursement password.
JAZZCASH_DISBURSE_PASSWORD=
# Only if your API version encrypts request bodies.
JAZZCASH_DISBURSE_AES_KEY=
# Easypaisa disbursement API base URL.
EASYPAISA_DISBURSE_BASE_URL=
# Easypaisa disbursement client id.
EASYPAISA_DISBURSE_CLIENT_ID=
# Easypaisa disbursement client secret.
EASYPAISA_DISBURSE_CLIENT_SECRET=
# Your Easypaisa account the payouts are sent from.
EASYPAISA_DISBURSE_ACCOUNT=

# ── Rewarded ads (AdMob) ────────────────────────────────────────────────────
# SSV callback URL to set in AdMob: https://<api>/v1/webhooks/admob/ssv
#
# dev | live | auto.
ADS_VERIFIER=dev              # dev | live | auto
# Rewarded ad unit ids (numeric part), comma-separated. Setting them makes ads live.
ADMOB_AD_UNIT_IDS=            # rewarded ad unit ids (numeric part), comma-separated

# ── Push notifications (Firebase Cloud Messaging) ───────────────────────────
# dev | live | auto.
PUSH_PROVIDER=dev             # dev | live | auto
# Firebase project id.
FCM_PROJECT_ID=
# Service account with FCM Admin role (defaults to GOOGLE_SERVICE_ACCOUNT_JSON).
FCM_SERVICE_ACCOUNT_JSON=     # defaults to GOOGLE_SERVICE_ACCOUNT_JSON

# ── Selfie verification ─────────────────────────────────────────────────────
# dev (approve if there's a photo) | rekognition (AWS face match) | manual (staff review).
VERIFICATION_PROVIDER=dev     # dev | rekognition | manual
# Face match % needed to approve automatically; lower goes to staff review.
VERIFICATION_MIN_SIMILARITY=90
# AWS region for Rekognition.
AWS_REGION=us-east-1
# AWS key with rekognition:DetectFaces + CompareFaces.
AWS_ACCESS_KEY_ID=
# Its secret.
AWS_SECRET_ACCESS_KEY=

# ── Media storage ───────────────────────────────────────────────────────────
# local (disk, one server) | s3 (our Garage container — see infra/garage — or AWS S3, Cloudflare R2, Backblaze B2, MinIO).
STORAGE_DRIVER=local          # local | s3
# Folder for local uploads.
UPLOAD_DIR=uploads
# Largest upload accepted (bytes).
MAX_UPLOAD_BYTES=5242880
# Public media bucket.
S3_BUCKET=
# Bucket with no public access (selfies waiting for review).
S3_PRIVATE_BUCKET=            # bucket with no public access (selfies awaiting review)
# Region (garage for our Garage container, auto for Cloudflare R2).
S3_REGION=auto
# Custom endpoint: http://vibe-storage:3900 (Garage), https://<account>.r2.cloudflarestorage.com (R2), empty for AWS.
S3_ENDPOINT=                  # R2: https://<account>.r2.cloudflarestorage.com
# Storage access key.
S3_ACCESS_KEY_ID=
# Storage secret key.
S3_SECRET_ACCESS_KEY=
# CDN / custom domain that serves the bucket. Empty = the API serves it at <PUBLIC_URL>/media.
S3_PUBLIC_URL=                # empty = served by the API at /media
# true for path-style URLs (Garage, MinIO).
S3_FORCE_PATH_STYLE=false

# ── Video calls (WebRTC / TURN relay) ───────────────────────────────────────
# The TURN server reads TURN_DOMAIN, TURN_SECRET and TURN_EXTERNAL_IP from this same file.
#
# STUN servers, comma-separated.
STUN_URLS=stun:stun.l.google.com:19302
# TURN addresses the app gets, comma-separated (udp, tcp, turns).
TURN_URLS=                    # e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
# Shared secret with coturn (static-auth-secret), at least 32 characters.
TURN_SECRET=                  # coturn static-auth-secret
# How long a TURN login lasts; must outlast the longest call.
TURN_TTL_SECONDS=86400

# ── Matching ────────────────────────────────────────────────────────────────
# How many waiting people one match search looks at.
MATCH_SCAN_LIMIT=200
# How often waiting people are re-matched (ms).
MATCH_SWEEP_MS=1000
# Dev only: bot partners join after this many ms of waiting (0 = off; must be 0 in production).
DEV_BOTS_AFTER_MS=1500
