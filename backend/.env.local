# ── Core ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
PUBLIC_URL=http://localhost:3000
CORS_ORIGINS=*
DATABASE_URL=postgresql://vibe:vibe@localhost:5432/vibe?schema=public
REDIS_URL=redis://localhost:6379
# At least 32 random characters in production: `openssl rand -base64 48`
JWT_ACCESS_SECRET=FfjujyDPV9BlkMeFOlZbWZ0Tuxcq5+n4AO0nNs2dOBDFIqd9K3wpUywaEfWvwTk+
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Daily rewards/limits reset at local midnight of this offset (PKT = 300)
BUSINESS_TZ_OFFSET_MINUTES=300
LOG_LEVEL=info
SWAGGER_ENABLED=true
RATE_LIMIT_PER_MINUTE=120

# ── Admin panel (staff) ──────────────────────────────────────────────────
# Required in production, different from JWT_ACCESS_SECRET: `openssl rand -base64 48`
JWT_STAFF_SECRET=CEnP0ZQo+sC8XquL/k9zZArCDHpur9e0kwKIaZQdK7hs0rueS5Ryocot+baJ7E3M
STAFF_ACCESS_TTL_SECONDS=600
STAFF_SESSION_HOURS=12
STAFF_LOGIN_MAX_FAILURES=5
STAFF_LOGIN_LOCK_MINUTES=15
STAFF_TOTP_ISSUER=Vibe Admin
# First owner account, created by `npm run db:seed` (change the password after signing in)
ADMIN_EMAIL=owner@vibe.local
ADMIN_PASSWORD=ChangeMe-2026

# ── Sign-in ──────────────────────────────────────────────────────────────
# Sign-in codes are e-mailed. console = print them to the log; smtp = really send.
MAIL_PROVIDER=smtp         # console | smtp
# Gmail: your address + a 16-character App Password
# (Google Account → Security → 2-Step Verification → App passwords). Not your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true              # true for 465, false for 587
SMTP_USER=fawadeqbal@gmail.com
SMTP_PASS=wbfgfdbdoqheascp
MAIL_FROM=Vibe <fawadeqbal@gmail.com>
OTP_TTL_SECONDS=600           # codes last 10 minutes
# OTP_FIXED_CODE=1234           # dev only: every code is 1234 (ignored in production)
SOCIAL_VERIFIER=dev           # dev (tokens "dev:<id>") | jwks (real Google/Apple)
GOOGLE_CLIENT_IDS=            # comma-separated OAuth client ids (Android, iOS, web)
APPLE_CLIENT_IDS=             # your bundle id / service id

# ── Money ────────────────────────────────────────────────────────────────
PAYMENTS_PROVIDER=dev         # dev | live
DEV_PAYMENTS_FAIL_EVERY=0     # dev: decline every Nth charge to test failures
PAYMENT_WEBHOOK_SECRET=change-me
# live provider:
GOOGLE_PLAY_PACKAGE=
GOOGLE_SERVICE_ACCOUNT_JSON=
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=
ADS_VERIFIER=dev              # dev | admob (server-side verification webhook)

# ── Media ────────────────────────────────────────────────────────────────
STORAGE_DRIVER=local
UPLOAD_DIR=uploads
MAX_UPLOAD_BYTES=5242880

# ── WebRTC ───────────────────────────────────────────────────────────────
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=                    # e.g. turn:turn.example.com:3478,turns:turn.example.com:5349
TURN_SECRET=                  # coturn static-auth-secret
TURN_TTL_SECONDS=3600

# ── Matching ─────────────────────────────────────────────────────────────
MATCH_SCAN_LIMIT=200
MATCH_SWEEP_MS=1000
# Dev only: scripted bot partners join after this many ms of waiting (0 = off)
DEV_BOTS_AFTER_MS=1500
