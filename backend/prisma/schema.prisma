// Vibe data model.
//
// Money rules this schema protects:
// * Every coin or gem that moves is a LedgerEntry; Wallet holds the running
//   balance and is only ever changed in the same transaction as its entry.
// * Balances can never go negative (CHECK constraints in the migration).
// * External payments are idempotent per (user, idempotencyKey) and per
//   provider reference.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── identity ───────────────────────────────────────────────────────────

enum Gender {
  MALE
  FEMALE
  OTHER
}

/// Back-office access uses StaffUser + StaffRole (see "back office" below).
/// ADMIN is kept only for compatibility with existing rows.
enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  DELETED
}

model User {
  id                   String     @id @default(cuid())
  role                 UserRole   @default(USER)
  status               UserStatus @default(ACTIVE)
  /// Sign-in e-mail, lower-cased. Null for social-only and deleted accounts.
  email                String?    @unique
  name                 String     @default("")
  age                  Int?
  gender               Gender     @default(OTHER)
  countryCode          String     @default("PK") @db.VarChar(2)
  avatarUrl            String     @default("")
  bio                  String     @default("") @db.VarChar(160)
  interests            String[]   @default([])
  verified             Boolean    @default(false)
  verifiedAt           DateTime?
  /// Development-only scripted partners (see DevBotsService). Never true in production.
  isBot                Boolean    @default(false)
  /// Newsletters and announcements by e-mail (sign-in codes and service notices always go).
  marketingEmails      Boolean    @default(true)
  onboardedAt          DateTime?
  bannedUntil          DateTime?
  inviteCode           String     @unique
  /// Kept in sync with the user Referral (inviterId) — the admin panel reads it.
  invitedById          String?
  /// Legacy (pre-Referral) invite reward marker; no longer written.
  inviteRewardedAt     DateTime?
  /// sha256(HMAC) of the install id sent at sign-up (referral fraud checks).
  signupDeviceHash     String?
  /// Referrals of this user that reached REWARDED (milestones, Ambassador badge).
  referralsRewarded    Int        @default(0)
  matchesCount         Int        @default(0)
  likesCount           Int        @default(0)
  /// ACTIVE follows only; moved in the same transaction as the Follow row.
  followersCount       Int        @default(0)
  followingCount       Int        @default(0)
  giftsReceivedCount   Int        @default(0)
  /// Follows need approval.
  privateAccount       Boolean    @default(false)
  /// Matches, likes and gifts are hidden from other people.
  hideStats            Boolean    @default(false)
  /// Engagement: XP (level is derived), badge counters, matching quality.
  xp                   Int        @default(0)
  /// Calls that lasted 60 s or more.
  goodCallsCount       Int        @default(0)
  /// Good calls that started 00:00–04:00 business time.
  nightCallsCount      Int        @default(0)
  giftsSentCount       Int        @default(0)
  /// Longest friend streak ever.
  bestStreak           Int        @default(0)
  /// Moving average (0–1) of how calls with this person go; the matcher pairs similar scores.
  vibeScore            Float      @default(0.5)
  /// Gems the user is saving towards (wallet goal card).
  gemGoal              Int?
  /// The goal value that was last celebrated (so each goal notifies once).
  gemGoalReachedFor    Int?
  /// Last win-back gift (free boost after a week away).
  winbackAt            DateTime?
  /// Quiet hours, minutes after midnight in the user's own offset; both set = on.
  quietHoursStart      Int?
  quietHoursEnd        Int?
  /// The device's UTC offset, sent by the app (quiet hours use it).
  tzOffsetMinutes      Int        @default(300)
  /// Break reminder after this many minutes in a search/call (30/60/90/120); null = off. Client-side timer.
  breakReminderMinutes Int?
  lastSeenAt           DateTime?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  deletedAt            DateTime?

  invitedBy      User?                 @relation("Invites", fields: [invitedById], references: [id], onDelete: SetNull)
  invitees       User[]                @relation("Invites")
  wallet         Wallet?
  sessions       Session[]
  ledger         LedgerEntry[]
  purchases      Purchase[]
  subscriptions  Subscription[]
  cashouts       Cashout[]
  blocksMade     Block[]               @relation("BlocksMade")
  blocksGot      Block[]               @relation("BlocksGot")
  followsMade    Follow[]              @relation("FollowsMade")
  followsGot     Follow[]              @relation("FollowsGot")
  reportsMade    Report[]              @relation("ReportsMade")
  reportsGot     Report[]              @relation("ReportsGot")
  staffNotes     StaffNote[]
  inbox          UserMessage[]
  identities     AuthIdentity[]
  payoutAccounts PayoutAccount[]
  pushTokens     PushToken[]
  verifications  VerificationRequest[]
  moments        Moment[]
  referralsMade  Referral[]            @relation("ReferralsMade")
  referralGot    Referral?             @relation("ReferralGot")
  affiliate      Affiliate?

  @@index([createdAt])
  @@index([bannedUntil])
  @@index([lastSeenAt])
}

enum AuthProvider {
  GOOGLE
  APPLE
  FACEBOOK
}

/// A social login linked to a user. One user can have several (Google +
/// Apple + Facebook); each provider account belongs to one user.
model AuthIdentity {
  id           String       @id @default(cuid())
  userId       String
  provider     AuthProvider
  /// The provider's stable user id (`sub`, or Facebook's app-scoped id).
  subject      String
  email        String?
  /// Sealed (SecretBox) provider refresh token. Apple: needed to revoke
  /// access when the account is deleted (App Store rule 5.1.1(v)).
  refreshToken String?
  createdAt    DateTime     @default(now())
  lastUsedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, subject])
  @@index([userId])
}

model Session {
  id          String    @id @default(cuid())
  userId      String
  /// sha256 of the opaque refresh token; the token itself is never stored.
  refreshHash String    @unique
  /// All rotations of one login share a family; reuse of a rotated token
  /// revokes the whole family.
  family      String
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([family])
}

// ── money ──────────────────────────────────────────────────────────────

model Wallet {
  userId                  String    @id
  coins                   Int       @default(0)
  gems                    Int       @default(0)
  vipUntil                DateTime?
  boostUntil              DateTime?
  streakDay               Int       @default(0)
  lastCheckInAt           DateTime?
  adsDay                  DateTime? @db.Date
  adsWatchedToday         Int       @default(0)
  friendRequestsDay       DateTime? @db.Date
  freeFriendRequestsToday Int       @default(0)
  profileBonusClaimed     Boolean   @default(false)
  /// Boosts given away (win-back); POST /wallet/boost uses one before coins.
  freeBoosts              Int       @default(0)
  updatedAt               DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum LedgerKind {
  PURCHASE
  SPEND
  EARN
  GIFT_SENT
  GIFT_RECEIVED
  CASHOUT
  CASHOUT_REVERSAL
  VIP
  REFUND
  ADJUSTMENT
}

enum PaymentMethod {
  GOOGLE_PLAY
  APP_STORE
  JAZZCASH
  EASYPAISA
  CARD
  BANK
}

model LedgerEntry {
  id             String         @id @default(cuid())
  userId         String
  kind           LedgerKind
  title          String
  coins          Int            @default(0)
  gems           Int            @default(0)
  usdCents       Int            @default(0)
  method         PaymentMethod?
  reference      String?
  /// Balance after this entry — makes audits a single query.
  balanceCoins   Int
  balanceGems    Int
  idempotencyKey String?
  createdAt      DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@index([kind, createdAt])
}

enum ProductType {
  COIN_PACK
  VIP_PLAN
}

enum PurchaseStatus {
  PENDING
  REQUIRES_ACTION
  SUCCEEDED
  FAILED
  REFUNDED
  /// Checkout abandoned: the user never finished (wallet approval, card page, bank transfer).
  EXPIRED
}

model Purchase {
  id             String         @id @default(cuid())
  userId         String
  productType    ProductType
  productId      String
  method         PaymentMethod
  usdCents       Int
  status         PurchaseStatus @default(PENDING)
  /// The provider's id for this charge (order id, transaction id).
  providerRef    String?
  /// What the user must do next: otp | approve_in_app | redirect | bank_transfer.
  nextAction     String?
  /// Data for that step (redirect URL + form fields, bank instructions…).
  actionData     Json?
  failureReason  String?
  idempotencyKey String
  /// Currency and amount actually charged (PKR for local methods, in minor units).
  currency       String         @default("USD") @db.VarChar(3)
  amountMinor    Int?
  /// Store subscription/purchase handle (Play purchase token, Apple original transaction id).
  storeRef       String?
  /// Unfinished checkouts expire at this time.
  expiresAt      DateTime?
  /// Status polling for pending charges.
  lastCheckedAt  DateTime?
  checkAttempts  Int            @default(0)
  metadata       Json?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?
  refundedAt     DateTime?

  user   User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  events PaymentEvent[]

  @@unique([userId, idempotencyKey])
  @@unique([method, providerRef])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([storeRef])
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  CANCELED
  EXPIRED
}

model Subscription {
  id               String             @id @default(cuid())
  userId           String
  planId           String
  status           SubscriptionStatus
  startedAt        DateTime           @default(now())
  currentPeriodEnd DateTime
  trialEndsAt      DateTime?
  canceledAt       DateTime?
  lastBonusAt      DateTime?
  purchaseId       String?            @unique
  /// How it's paid; store subscriptions renew through store notifications.
  method           PaymentMethod?
  /// Play purchase token / Apple original transaction id of the store subscription.
  storeRef         String?            @unique
  autoRenew        Boolean            @default(true)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
  @@index([createdAt])
}

enum CashoutStatus {
  /// Held for a human (above the review threshold, or payouts paused).
  REVIEW
  REQUESTED
  PROCESSING
  PAID
  REJECTED
}

model Cashout {
  id              String        @id @default(cuid())
  userId          String
  gems            Int
  usdCents        Int
  method          PaymentMethod
  /// PKR (whole rupees) fixed when requested, at the rate of that day.
  amountPkr       Int?
  /// Stored masked; the full account lives sealed on the PayoutAccount.
  accountMasked   String
  payoutAccountId String?
  status          CashoutStatus @default(REQUESTED)
  providerRef     String?
  /// Provider's own status text/code for the last attempt (e.g. awaiting_manual).
  providerStatus  String?
  failureReason   String?
  /// Bank payouts are paid by staff in batches (CSV export).
  batchId         String?
  attempts        Int           @default(0)
  lastCheckedAt   DateTime?
  createdAt       DateTime      @default(now())
  processedAt     DateTime?

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  payoutAccount PayoutAccount? @relation(fields: [payoutAccountId], references: [id], onDelete: SetNull)
  batch         PayoutBatch?   @relation(fields: [batchId], references: [id], onDelete: SetNull)
  events        PaymentEvent[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([batchId])
}

/// Where a user's cash-outs go. Details are sealed (AES-GCM); only the masked
/// number is readable. Soft-deleted so old cash-outs keep their link.
model PayoutAccount {
  id            String        @id @default(cuid())
  userId        String
  method        PaymentMethod
  /// SecretBox-sealed JSON: { account, holderName, bankName?, cnic? }.
  details       String
  accountMasked String
  holderName    String        @db.VarChar(80)
  bankName      String?       @db.VarChar(80)
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  cashouts Cashout[]

  @@index([userId])
}

enum PayoutBatchStatus {
  OPEN
  EXPORTED
  PAID
  CANCELED
}

/// A group of bank cash-outs staff pay together (bulk transfer file).
model PayoutBatch {
  id            String            @id @default(cuid())
  method        PaymentMethod
  status        PayoutBatchStatus @default(OPEN)
  count         Int               @default(0)
  totalUsdCents Int               @default(0)
  totalPkr      Int               @default(0)
  /// Bank's reference for the bulk transfer, entered when marked paid.
  reference     String?
  createdById   String
  createdAt     DateTime          @default(now())
  exportedAt    DateTime?
  paidAt        DateTime?

  cashouts Cashout[]

  @@index([status, createdAt])
}

/// Audit trail of every provider step for a purchase or cash-out
/// (charge sent, pending, status checked, webhook, refund…).
model PaymentEvent {
  id         String   @id @default(cuid())
  purchaseId String?
  cashoutId  String?
  provider   String
  type       String
  /// The provider's own status/response code, when there is one.
  code       String?
  message    String?
  /// Redacted request/response details.
  data       Json?
  createdAt  DateTime @default(now())

  purchase Purchase? @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  cashout  Cashout?  @relation(fields: [cashoutId], references: [id], onDelete: Cascade)

  @@index([purchaseId, createdAt])
  @@index([cashoutId, createdAt])
  @@index([createdAt])
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

/// Every callback from a provider, stored before it is acted on: duplicates
/// are dropped by (provider, eventId), failures can be retried from the admin panel.
model WebhookEvent {
  id          String        @id @default(cuid())
  provider    String
  /// The provider's event id, or a hash of the body when it has none.
  eventId     String
  eventType   String?
  status      WebhookStatus @default(RECEIVED)
  payload     Json
  headers     Json?
  error       String?
  attempts    Int           @default(0)
  /// What it was about, once processed (purchase / cashout / user / subscription).
  subjectType String?
  subjectId   String?
  receivedAt  DateTime      @default(now())
  processedAt DateTime?

  @@unique([provider, eventId])
  @@index([status, receivedAt])
  @@index([provider, receivedAt])
  @@index([subjectType, subjectId])
}

/// Device tokens for push notifications (FCM; covers Android and iOS).
model PushToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  platform   String   @db.VarChar(16)
  appVersion String?  @db.VarChar(32)
  locale     String?  @db.VarChar(16)
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum VerificationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// Selfie verification attempts. Automatic providers decide at once;
/// the manual provider leaves them PENDING for staff.
model VerificationRequest {
  id           String             @id @default(cuid())
  userId       String
  status       VerificationStatus @default(PENDING)
  provider     String
  /// Private storage key of the selfie (kept only while it needs review).
  selfieKey    String?
  similarity   Float?
  reason       String?
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// ── matching ───────────────────────────────────────────────────────────

enum MatchEndReason {
  SKIPPED
  LEFT
  STOPPED
  REPORTED
  BLOCKED
  DISCONNECTED
}

model Match {
  id          String          @id @default(cuid())
  userAId     String
  userBId     String
  startedAt   DateTime        @default(now())
  endedAt     DateTime?
  endedById   String?
  endReason   MatchEndReason?
  coinsSpentA Int             @default(0)
  coinsSpentB Int             @default(0)
  reconnect   Boolean         @default(false)

  likes MatchLike[]
  gifts GiftTransfer[]

  @@index([userAId, startedAt])
  @@index([userBId, startedAt])
  @@index([startedAt])
}

model MatchLike {
  matchId   String
  fromId    String
  toId      String
  createdAt DateTime @default(now())

  match Match @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@id([matchId, fromId])
  @@index([toId, createdAt])
}

model GiftTransfer {
  id        String   @id @default(cuid())
  giftId    String
  fromId    String
  toId      String
  coins     Int
  gems      Int
  matchId   String?
  createdAt DateTime @default(now())

  match Match? @relation(fields: [matchId], references: [id], onDelete: SetNull)

  @@index([toId, createdAt])
  @@index([fromId, createdAt])
}

// ── social ─────────────────────────────────────────────────────────────

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

/// One row per pair. userLowId < userHighId keeps the pair unique no matter
/// who asked first.
model Friendship {
  id            String           @id @default(cuid())
  userLowId     String
  userHighId    String
  requesterId   String
  status        FriendshipStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  acceptedAt    DateTime?
  lastMessageAt DateTime?
  /// Friend streak: consecutive business days both talked (see social/streaks.ts).
  streakCount   Int              @default(0)
  streakBest    Int              @default(0)
  /// Business day index of the last counted day.
  streakDay     Int?
  /// Last business day each side was active (sent a message/gift or was in a call together).
  streakLowDay  Int?
  streakHighDay Int?

  messages Message[]

  @@unique([userLowId, userHighId])
  @@index([userLowId, status])
  @@index([userHighId, status])
  @@index([status, streakDay])
}

model Message {
  id           String    @id @default(cuid())
  friendshipId String
  senderId     String
  text         String    @db.VarChar(1000)
  giftId       String?
  createdAt    DateTime  @default(now())
  readAt       DateTime?

  friendship Friendship @relation(fields: [friendshipId], references: [id], onDelete: Cascade)

  @@index([friendshipId, createdAt])
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksGot", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

enum FollowStatus {
  PENDING
  ACTIVE
}

/// One-way follow. Free; a private account approves each request (PENDING).
/// Following never unlocks chat — that stays with Friendship.
model Follow {
  id         String       @id @default(cuid())
  followerId String
  followeeId String
  status     FollowStatus @default(ACTIVE)
  createdAt  DateTime     @default(now())
  acceptedAt DateTime?

  follower User @relation("FollowsMade", fields: [followerId], references: [id], onDelete: Cascade)
  followee User @relation("FollowsGot", fields: [followeeId], references: [id], onDelete: Cascade)

  @@unique([followerId, followeeId])
  @@index([followeeId, status, createdAt])
  @@index([followerId, status, createdAt])
}

/// A 24-hour photo ("Moments"), seen by followers and friends.
model Moment {
  id         String    @id @default(cuid())
  userId     String
  mediaKey   String
  mediaUrl   String
  caption    String    @default("") @db.VarChar(120)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime
  viewsCount Int       @default(0)
  deletedAt  DateTime?

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  views MomentView[]

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model MomentView {
  momentId  String
  viewerId  String
  createdAt DateTime @default(now())

  moment Moment @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@id([momentId, viewerId])
}

// ── growth: referrals and affiliates ───────────────────────────────────
//
// One Referral per invited user (sign-up with a code, or a late claim),
// from a user invite code or an affiliate (creator partner) code. Users
// earn coins when the people they invite become active; affiliates earn
// money (AffiliateCommission) on the purchases of the people they bring.

enum ReferralStatus {
  PENDING
  QUALIFIED
  REWARDED
  REJECTED
}

model Referral {
  id           String         @id @default(cuid())
  /// User referrals: the inviter. Null for affiliate referrals.
  inviterId    String?
  affiliateId  String?
  inviteeId    String         @unique
  /// The code as used (upper-case).
  code         String
  /// How the code arrived: link | install | code | web.
  source       String         @db.VarChar(16)
  /// `s=` of the share link (tiktok, whatsapp…).
  channel      String?        @db.VarChar(24)
  status       ReferralStatus @default(PENDING)
  rejectReason String?        @db.VarChar(120)
  deviceHash   String?
  ip           String?        @db.VarChar(64)
  qualifiedAt  DateTime?
  rewardedAt   DateTime?
  inviterCoins Int            @default(0)
  inviteeCoins Int            @default(0)
  createdAt    DateTime       @default(now())

  inviter     User?                 @relation("ReferralsMade", fields: [inviterId], references: [id], onDelete: SetNull)
  invitee     User                  @relation("ReferralGot", fields: [inviteeId], references: [id], onDelete: Cascade)
  affiliate   Affiliate?            @relation(fields: [affiliateId], references: [id], onDelete: SetNull)
  commissions AffiliateCommission[]

  @@index([inviterId, createdAt])
  @@index([affiliateId, createdAt])
  @@index([status, qualifiedAt])
  @@index([deviceHash, createdAt])
  @@index([createdAt])
}

/// Landing-page visits per code, channel and business day (deduped per IP per hour).
model ReferralClick {
  code    String
  /// `s=` of the link; "direct" when none.
  channel String   @db.VarChar(24)
  day     DateTime @db.Date
  clicks  Int      @default(0)

  @@id([code, channel, day])
  @@index([day])
}

enum AffiliateStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

model Affiliate {
  id              String          @id @default(cuid())
  userId          String          @unique
  /// Vanity code, upper-case; unique across affiliate and user invite codes.
  code            String          @unique
  displayName     String          @db.VarChar(40)
  status          AffiliateStatus @default(PENDING)
  /// Null = the economy default (affiliateRevSharePercent / affiliateCpaUsdCents).
  revSharePercent Int?
  cpaUsdCents     Int?
  /// [{ platform, url, followers }]
  channels        Json            @default("[]")
  /// The applicant's message.
  note            String          @default("") @db.VarChar(1000)
  staffNote       String?         @db.VarChar(2000)
  /// Shown to the applicant when rejected or suspended.
  decisionReason  String?         @db.VarChar(300)
  appliedAt       DateTime        @default(now())
  decidedAt       DateTime?
  decidedById     String?
  updatedAt       DateTime        @updatedAt

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals   Referral[]
  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]

  @@index([status, appliedAt])
}

enum AffiliateCommissionKind {
  REVSHARE
  CPA
}

enum AffiliateCommissionStatus {
  PENDING
  AVAILABLE
  PAID
  REVERSED
  HELD
}

/// Money an affiliate earned (USD cents). Negative rows take back a
/// commission that was already paid out (its purchase was refunded).
model AffiliateCommission {
  id           String                    @id @default(cuid())
  affiliateId  String
  referralId   String
  purchaseId   String?
  kind         AffiliateCommissionKind
  /// Dedupe: rev:<purchaseId> | cpa:<referralId> | undo:<commissionId>.
  key          String                    @unique
  baseUsdCents Int
  usdCents     Int
  status       AffiliateCommissionStatus @default(PENDING)
  availableAt  DateTime
  payoutId     String?
  createdAt    DateTime                  @default(now())

  affiliate Affiliate        @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  referral  Referral         @relation(fields: [referralId], references: [id], onDelete: Cascade)
  payout    AffiliatePayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  @@index([affiliateId, status])
  @@index([affiliateId, createdAt])
  @@index([status, availableAt])
  @@index([payoutId])
  @@index([purchaseId])
}

enum AffiliatePayoutStatus {
  REQUESTED
  PAID
  REJECTED
}

model AffiliatePayout {
  id              String                @id @default(cuid())
  affiliateId     String
  usdCents        Int
  /// Whole rupees at the cash-out rate of the day it was requested.
  amountPkr       Int
  payoutAccountId String?
  accountMasked   String
  method          PaymentMethod
  status          AffiliatePayoutStatus @default(REQUESTED)
  reference       String?
  failureReason   String?
  createdAt       DateTime              @default(now())
  decidedAt       DateTime?
  decidedById     String?

  affiliate   Affiliate             @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  commissions AffiliateCommission[]

  @@index([affiliateId, createdAt])
  @@index([status, createdAt])
}

// ── safety ─────────────────────────────────────────────────────────────

enum ReportReason {
  NUDITY
  HARASSMENT
  UNDERAGE
  SPAM
  SCAM
  OTHER
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  matchId    String?
  reason     ReportReason
  note       String?      @db.VarChar(500)
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now())
  reviewedAt DateTime?

  reporter User @relation("ReportsMade", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("ReportsGot", fields: [reportedId], references: [id], onDelete: Cascade)

  @@unique([reporterId, reportedId, matchId])
  @@index([reportedId, createdAt])
  @@index([status, createdAt])
}

// ── back office ────────────────────────────────────────────────────────
//
// Staff are separate from app users: own credentials (password + TOTP),
// own sessions and a role whose permission list the API enforces per
// endpoint. Every staff write lands in AuditLog.

enum StaffStatus {
  ACTIVE
  DISABLED
}

model StaffRole {
  id          String   @id @default(cuid())
  /// Stable slug ("owner", "moderator", or a custom one).
  key         String   @unique
  name        String
  description String   @default("")
  /// Permission keys from src/modules/admin/core/permissions.ts ("*" = all).
  permissions String[]
  /// Built-in roles can't be deleted or renamed.
  system      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  staff StaffUser[]
}

model StaffUser {
  id                 String      @id @default(cuid())
  email              String      @unique
  name               String
  passwordHash       String
  roleId             String
  status             StaffStatus @default(ACTIVE)
  /// AES-GCM encrypted TOTP secret; null until 2FA is set up.
  totpSecret         String?
  totpEnabledAt      DateTime?
  /// sha256 of unused one-time recovery codes.
  recoveryCodes      String[]    @default([])
  mustChangePassword Boolean     @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  lastLoginIp        String?
  createdById        String?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  role     StaffRole      @relation(fields: [roleId], references: [id])
  sessions StaffSession[]
  notes    StaffNote[]

  @@index([roleId])
}

model StaffSession {
  id          String    @id @default(cuid())
  staffId     String
  refreshHash String    @unique
  family      String
  userAgent   String?
  ip          String?
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime  @default(now())
  createdAt   DateTime  @default(now())

  staff StaffUser @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([family])
}

/// Append-only record of every staff action.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorEmail String
  action     String
  targetType String?
  targetId   String?
  summary    String?
  data       Json?
  ip         String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

model StaffNote {
  id        String   @id @default(cuid())
  userId    String
  authorId  String
  text      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  author StaffUser @relation(fields: [authorId], references: [id])

  @@index([userId, createdAt])
}

/// Runtime settings (maintenance mode, payout review…); typed in code.
model AppSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

enum AnnouncementAudience {
  ALL
  VIP
  NON_VIP
}

enum AnnouncementStatus {
  DRAFT
  LIVE
  ARCHIVED
}

model Announcement {
  id          String               @id @default(cuid())
  title       String               @db.VarChar(80)
  body        String               @db.VarChar(500)
  audience    AnnouncementAudience @default(ALL)
  status      AnnouncementStatus   @default(DRAFT)
  createdById String
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([status, publishedAt])
}

// ── messaging ──────────────────────────────────────────────────────────
//
// E-mail templates are structured (subject, heading, body…) and rendered
// into one branded layout, so staff can edit wording without breaking
// e-mail clients. Campaigns send a message by e-mail and/or to the in-app
// inbox, to picked people, a segment or everyone, in resumable batches.

/// Staff edits of built-in templates, and custom templates. Built-in
/// defaults live in code (mail-templates.registry.ts); a row overrides them.
model MailTemplate {
  key         String   @id
  name        String
  description String   @default("")
  subject     String   @db.VarChar(200)
  preheader   String   @default("") @db.VarChar(200)
  heading     String   @db.VarChar(200)
  body        String   @db.VarChar(5000)
  highlight   String   @default("") @db.VarChar(100)
  buttonLabel String   @default("") @db.VarChar(60)
  buttonUrl   String   @default("") @db.VarChar(500)
  footer      String   @default("") @db.VarChar(500)
  custom      Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum CampaignAudience {
  USERS
  SEGMENT
  ALL
}

enum CampaignStatus {
  QUEUED
  SENDING
  SENT
  CANCELED
  FAILED
}

model Campaign {
  id           String           @id @default(cuid())
  /// Internal name, shown in the admin panel only.
  name         String           @db.VarChar(120)
  sendEmail    Boolean
  sendInApp    Boolean
  /// Service notice: also e-mails people who turned off e-mail updates.
  important    Boolean          @default(false)
  audience     CampaignAudience
  userIds      String[]         @default([])
  segment      Json?
  templateKey  String?
  subject      String           @db.VarChar(200)
  preheader    String           @default("") @db.VarChar(200)
  heading      String           @db.VarChar(200)
  body         String           @db.VarChar(5000)
  buttonLabel  String           @default("") @db.VarChar(60)
  buttonUrl    String           @default("") @db.VarChar(500)
  footer       String           @default("") @db.VarChar(500)
  status       CampaignStatus   @default(QUEUED)
  /// Recipients when queued (estimate for segments; they're resolved while sending).
  total        Int              @default(0)
  processed    Int              @default(0)
  emailSent    Int              @default(0)
  emailFailed  Int              @default(0)
  emailSkipped Int              @default(0)
  inAppSent    Int              @default(0)
  /// Resume point: the last user id handled (users are walked in id order).
  cursor       String?
  lastError    String?
  createdById  String
  createdAt    DateTime         @default(now())
  startedAt    DateTime?
  finishedAt   DateTime?

  deliveries MessageDelivery[]

  @@index([status, createdAt])
  @@index([createdAt])
}

enum DeliveryStatus {
  SENT
  FAILED
  SKIPPED
}

/// One row per recipient e-mail: makes resends impossible and failures visible.
model MessageDelivery {
  id         String         @id @default(cuid())
  campaignId String
  userId     String
  email      String?
  status     DeliveryStatus
  error      String?        @db.VarChar(300)
  createdAt  DateTime       @default(now())

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([campaignId, status])
}

/// The in-app inbox ("Messages from Vibe").
model UserMessage {
  id          String    @id @default(cuid())
  userId      String
  campaignId  String?
  title       String    @db.VarChar(200)
  body        String    @db.VarChar(5000)
  buttonLabel String    @default("") @db.VarChar(60)
  buttonUrl   String    @default("") @db.VarChar(500)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([campaignId, userId])
  @@index([userId, createdAt])
  @@index([userId, readAt])
}
