# ── Vibe Production .env ─────────────────────────────────────────────────────
# Generated for deployment on fawadiqbal.dev server

# ── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
PUBLIC_URL=https://api.vibe.fawadiqbal.dev
CORS_ORIGINS=*
DATABASE_URL=postgresql://vibe:CHANGE_DB_PASSWORD@postgres:5432/vibe?schema=public
REDIS_URL=redis://redis:6379
VIBE_DB_PASSWORD=CHANGE_DB_PASSWORD

# IMPORTANT: Real secrets are auto-generated by deploy.ps1
JWT_ACCESS_SECRET=CHANGE_ME_jwt_access_secret_production
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
BUSINESS_TZ_OFFSET_MINUTES=300
LOG_LEVEL=info
SWAGGER_ENABLED=false
RATE_LIMIT_PER_MINUTE=120

# ── Admin panel (staff) ─────────────────────────────────────────────────────
JWT_STAFF_SECRET=CHANGE_ME_jwt_staff_secret_production
STAFF_ACCESS_TTL_SECONDS=600
STAFF_SESSION_HOURS=12
STAFF_LOGIN_MAX_FAILURES=5
STAFF_LOGIN_LOCK_MINUTES=15
STAFF_TOTP_ISSUER=Vibe Admin
ADMIN_EMAIL=owner@vibe.local
ADMIN_PASSWORD=ChangeMe-2026

# ── Sign-in ──────────────────────────────────────────────────────────────────
MAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=fawadeqbal@gmail.com
SMTP_PASS=wbfgfdbdoqheascp
MAIL_FROM=Vibe <fawadeqbal@gmail.com>
OTP_TTL_SECONDS=600
SOCIAL_VERIFIER=dev
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=

# ── Money ────────────────────────────────────────────────────────────────────
