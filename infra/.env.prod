# ════════════════════════════════════════════════════════════════════════════
#  Vibe — production settings
#  infra/deploy.ps1 copies this to /opt/vibe/.env on the server; the API, admin
#  and TURN containers read it. Placeholder secrets (CHANGE_...) are replaced by
#  real generated ones on the server and kept across deploys.
#  Full guide to the integration keys: backend/INTEGRATIONS.md
#  After editing on the server: docker compose up -d --force-recreate
# ════════════════════════════════════════════════════════════════════════════

# ── Core ────────────────────────────────────────────────────────────────────
# The basics every environment needs.
#
# development | test | production (production enables the safety checks).
NODE_ENV=production
# Port the API listens on inside its container/host.
PORT=3000
# Public address of the API; used to build webhook, return and media URLs.
PUBLIC_URL=https://api.vibe.fawadiqbal.dev
# Comma-separated browser origins allowed to call the API (* = any).
CORS_ORIGINS=*
# PostgreSQL connection string.
DATABASE_URL=postgresql://vibe:CHANGE_DB_PASSWORD@postgres:5432/vibe?schema=public
# Redis connection string (queues, locks, presence, caches).
REDIS_URL=redis://redis:6379
# Postgres password used by docker compose (deploy.ps1 keeps or generates it).
VIBE_DB_PASSWORD=CHANGE_DB_PASSWORD
# Daily rewards/limits reset at local midnight of this offset (Pakistan = 300).
BUSINESS_TZ_OFFSET_MINUTES=300
# fatal | error | warn | info | debug | trace.
LOG_LEVEL=info
# Serve the API docs at /docs (true/false).
SWAGGER_ENABLED=false
# Requests per minute per IP/user before 429.
RATE_LIMIT_PER_MINUTE=120

# ── App sign-in tokens ──────────────────────────────────────────────────────
# Secrets: at least 32 random characters (openssl rand -base64 48). Real values are generated by deploy.ps1.
#
# Signs app access tokens. Changing it signs everyone out.
JWT_ACCESS_SECRET=CHANGE_ME_jwt_access_secret_production
# How long an access token lives (seconds).
JWT_ACCESS_TTL_SECONDS=900
# How long a login lasts without opening the app (days).
REFRESH_TTL_DAYS=30
# Seals payout account numbers and provider refresh tokens. Set once, never change. Required when payouts are live.
DATA_ENCRYPTION_KEY=

# ── Admin panel (staff) ─────────────────────────────────────────────────────
# Signs staff tokens; must differ from JWT_ACCESS_SECRET.
JWT_STAFF_SECRET=CHANGE_ME_jwt_staff_secret_production
# Staff access token lifetime (seconds).
STAFF_ACCESS_TTL_SECONDS=600
# Staff stay signed in this long (hours).
STAFF_SESSION_HOURS=12
# Wrong passwords before a staff account is locked.
STAFF_LOGIN_MAX_FAILURES=5
# How long a locked staff account waits (minutes).
STAFF_LOGIN_LOCK_MINUTES=15
# Name shown in authenticator apps.
STAFF_TOTP_ISSUER=Vibe Admin
# First owner account, created by `npm run db:seed`.
ADMIN_EMAIL=owner@vibe.local
# Its first password (change it after signing in).
ADMIN_PASSWORD=ChangeMe-2026

# ── E-mail and sign-in codes ────────────────────────────────────────────────
# Sign-in codes are e-mailed. Gmail: your address + a 16-character App Password (Google Account -> Security -> App passwords).
#
# console = print codes to the log (dev) | smtp = really send.
MAIL_PROVIDER=smtp
# SMTP server (smtp.gmail.com for Gmail).
SMTP_HOST=smtp.gmail.com
# 465 (TLS) or 587 (STARTTLS).
SMTP_PORT=465
# true for 465, false for 587.
SMTP_SECURE=true
# SMTP login (your Gmail address).
SMTP_USER=fawadeqbal@gmail.com
# SMTP password / Gmail App Password. Never commit a real one.
SMTP_PASS=wbfgfdbdoqheascp
# Sender people see, e.g. Vibe <you@gmail.com>.
MAIL_FROM=Vibe <fawadeqbal@gmail.com>
# How long a sign-in code works (seconds).
OTP_TTL_SECONDS=600

# ── Social sign-in (Google, Apple, Facebook) ────────────────────────────────
# Integration switches: dev = built-in test stand-in (no keys, no real money/messages),
# See backend/INTEGRATIONS.md for where to get each key.
#
# dev (tokens dev:<id>) | live | auto.
SOCIAL_VERIFIER=dev
# Google OAuth client ids, comma-separated: Web (the app's serverClientId) + iOS.
GOOGLE_CLIENT_IDS=
# Apple bundle id (iOS) + Services ID (Android), comma-separated.
APPLE_CLIENT_IDS=
# Apple team id (for revoking Apple sign-in when an account is deleted).
APPLE_TEAM_ID=
# Sign in with Apple key id.
APPLE_SIGNIN_KEY_ID=
# Sign in with Apple key (.p8): literal with \n, base64:..., or file:/path.
APPLE_SIGNIN_PRIVATE_KEY=
# Meta for Developers app id.
FACEBOOK_APP_ID=
# Meta app secret.
FACEBOOK_APP_SECRET=

# ── Payments (money in) ─────────────────────────────────────────────────────
# Integration switches: dev = built-in test stand-in (no keys, no real money/messages),
# live = the real provider (anything without keys is turned off),
# auto = live where keys are set, dev for the rest (off in production).
# Admin panel -> Operations -> Integrations shows what is live and which keys are missing.
#
# dev | live | auto for all payment methods.
PAYMENTS_PROVIDER=dev
# Dev only: decline every Nth charge to test failures (0 = never).
DEV_PAYMENTS_FAIL_EVERY=0
# Signs the generic /webhooks/payments callback and dev card webhooks.
PAYMENT_WEBHOOK_SECRET=CHANGE_ME_webhook_secret
# Where hosted payment pages send people back (the app's deep link).
PAYMENT_RETURN_URL=vibe://payment-return

# ── Payments: Google Play Billing ───────────────────────────────────────────
# Play Console service account with View financial data + Manage orders.
#
# Android package name, e.g. com.pingcrood.vibe_app.
GOOGLE_PLAY_PACKAGE=
# Service account key JSON: literal, base64:..., or file:/path.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Pub/Sub push audience (= https://<api>/v1/webhooks/google-play); turns on token checks.
GOOGLE_PLAY_RTDN_AUDIENCE=

# ── Payments: App Store ─────────────────────────────────────────────────────
# App Store Connect -> Users and Access -> Integrations -> In-App Purchase key.
#
# Issuer id of the In-App Purchase key.
APPLE_ISSUER_ID=
# In-App Purchase key id.
APPLE_KEY_ID=
# In-App Purchase key (.p8): literal with \n, base64:..., or file:/path.
APPLE_PRIVATE_KEY=
# iOS bundle id.
APPLE_BUNDLE_ID=
# Numeric app id (App Store Connect -> App Information).
APPLE_APP_APPLE_ID=

# ── Payments: JazzCash ──────────────────────────────────────────────────────
# JazzCash merchant portal. Return/IPN URL: https://<api>/v1/webhooks/jazzcash
#
# sandbox | production.
JAZZCASH_ENV=sandbox
# Merchant ID.
JAZZCASH_MERCHANT_ID=
# Merchant password.
JAZZCASH_PASSWORD=
# Integrity salt (signs pp_SecureHash).
JAZZCASH_INTEGRITY_SALT=

# ── Payments: Easypaisa ─────────────────────────────────────────────────────
# Easypay merchant account. IPN URL: https://<api>/v1/webhooks/easypaisa
#
# sandbox | production.
EASYPAISA_ENV=sandbox
# Store id.
EASYPAISA_STORE_ID=
# API username.
EASYPAISA_USERNAME=
# API password.
EASYPAISA_PASSWORD=
# Your merchant Easypaisa account number (needed by the status inquiry).
EASYPAISA_ACCOUNT_NUM=

# ── Payments: card gateway ──────────────────────────────────────────────────
# Hosted checkout. dev = built-in test page with Pay / Decline. Webhook: https://<api>/v1/webhooks/card/<name>
#
# dev, or the name of a real gateway added in card/gateways/.
CARD_GATEWAY=dev

# ── Payouts (gems cash-out) ─────────────────────────────────────────────────
# Integration switches: dev = built-in test stand-in (no keys, no real money/messages),
# Bank payouts are always staff batches (Finance -> Payout batches); no keys.
#
# dev | live | auto for JazzCash/Easypaisa payouts.
PAYOUTS_PROVIDER=dev

# ── Rewarded ads (AdMob) ────────────────────────────────────────────────────
# SSV callback URL to set in AdMob: https://<api>/v1/webhooks/admob/ssv
#
# dev | live | auto.
ADS_VERIFIER=dev
# Rewarded ad unit ids (numeric part), comma-separated. Setting them makes ads live.
ADMOB_AD_UNIT_IDS=

# ── Push notifications (Firebase Cloud Messaging) ───────────────────────────
# dev | live | auto.
PUSH_PROVIDER=dev
# Firebase project id.
FCM_PROJECT_ID=

# ── Selfie verification ─────────────────────────────────────────────────────
# dev (approve if there's a photo) | rekognition (AWS face match) | manual (staff review).
VERIFICATION_PROVIDER=dev

# ── Media storage ───────────────────────────────────────────────────────────
# local (disk, one server) | s3 (AWS S3, Cloudflare R2, Backblaze B2, MinIO).
STORAGE_DRIVER=local
# Folder for local uploads.
UPLOAD_DIR=uploads
# Largest upload accepted (bytes).
MAX_UPLOAD_BYTES=5242880

# ── Video calls (WebRTC / TURN relay) ───────────────────────────────────────
# The TURN server reads TURN_DOMAIN, TURN_SECRET and TURN_EXTERNAL_IP from this same file.
#
# STUN servers, comma-separated.
STUN_URLS=stun:stun.l.google.com:19302
# TURN server domain (its certificate is issued for it).
TURN_DOMAIN=turn.vibe.fawadiqbal.dev
# public-ip/private-ip of the TURN machine (needed on Oracle/AWS/GCP/Azure).
TURN_EXTERNAL_IP=145.241.156.60/10.0.0.44
# TURN addresses the app gets, comma-separated (udp, tcp, turns).
TURN_URLS=turn:turn.vibe.fawadiqbal.dev:3478?transport=udp,turn:turn.vibe.fawadiqbal.dev:3478?transport=tcp,turns:turn.vibe.fawadiqbal.dev:5349?transport=tcp
# Shared secret with coturn (static-auth-secret), at least 32 characters.
TURN_SECRET=e2f886ed47f67d31c9dfb7c143768c3173b6bfba13d5c7b71116ea810b2ed406
# How long a TURN login lasts; must outlast the longest call.
TURN_TTL_SECONDS=86400

# ── Matching ────────────────────────────────────────────────────────────────
# How many waiting people one match search looks at.
MATCH_SCAN_LIMIT=200
# How often waiting people are re-matched (ms).
MATCH_SWEEP_MS=1000
# Dev only: bot partners join after this many ms of waiting (0 = off; must be 0 in production).
DEV_BOTS_AFTER_MS=0
