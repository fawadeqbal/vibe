# ── TURN server settings ── copy to .env and fill in ────────────────────────

# The TURN server's domain name. Point an A record at this server's public IP.
TURN_DOMAIN=turn.example.com

# Shared secret. Must be EXACTLY the same as TURN_SECRET in the API's .env.
# Make one with:  openssl rand -hex 32
TURN_SECRET=c8742141eb65dff70194eec00b5ee1545632b7e2c5608e36b33662413d3b43d1

# Port for encrypted TURN (turns:). 5349 is standard. Use 443 if this server
# only runs TURN: office/hotel/university Wi-Fi often allows only port 443.
TURN_TLS_PORT=5349

# Leave empty if the server's public IP is on its network card (Hetzner,
# DigitalOcean, Vultr, Linode, most VPS). On AWS / Google Cloud / Azure /
# Oracle, set it to "auto" (or the public IP).
TURN_EXTERNAL_IP=

# UDP ports used for the relayed audio/video. Open the same range in the
# firewall. About 1 port per person on a relayed call.
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

# E-mail for the Let's Encrypt certificate (expiry warnings only).
CERT_EMAIL=you@example.com
