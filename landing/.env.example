# ── Brand & domain: change these two and rebuild to rename the product or move
# it to a new domain. Every title, heading, schema block, share image, sitemap
# and article reads them (see SEO.md → "Renaming / moving domains").
NEXT_PUBLIC_BRAND_NAME=Vibe
# Company/publisher name for schema.org; defaults to the brand name.
NEXT_PUBLIC_BRAND_LEGAL_NAME=
# Public site address, for canonical/OG tags, sitemap, robots, RSS. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://vibe.fawadiqbal.dev

# ── Search engines & analytics (all optional, empty = tag not rendered)
# Search Console → Add property → URL prefix → HTML tag → paste only the content="…" value.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → HTML meta tag (msvalidate.01) content value.
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
# Google Analytics 4 measurement id, e.g. G-ABC123XYZ.
NEXT_PUBLIC_GA_ID=
# Official profiles, comma-separated (Instagram, TikTok, X, Facebook, YouTube, Play Store page…).
# They become schema.org sameAs links, which help Google build a knowledge panel for the brand.
NEXT_PUBLIC_SOCIAL_LINKS=
# X/Twitter handle for share cards, e.g. @getvibe.
NEXT_PUBLIC_TWITTER_HANDLE=
NEXT_PUBLIC_SUPPORT_EMAIL=

# Where the buttons go. NEXT_PUBLIC_* values are baked in at build time.
# "Start matching", VIP trial, invite → the web app (web/).
NEXT_PUBLIC_WEB_APP_URL=https://app.vibe.fawadiqbal.dev
# "Get the app" / "Android" / "Get Vibe for Android" → Play Store listing or a direct .apk.
NEXT_PUBLIC_ANDROID_URL=https://play.google.com/store/apps/details?id=com.example.vibe
# The Vibe API (same value as web/). The hero pill reads the live online count
# from GET <API>/v1/stats/online; leave empty to always show the fallback.
NEXT_PUBLIC_VIBE_API=https://api.vibe.fawadiqbal.dev
NEXT_PUBLIC_ONLINE_FALLBACK=2743
# Footer links (default: the FAQ section).
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_SUPPORT_URL=
