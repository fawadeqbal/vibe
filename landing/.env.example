# Where the buttons go. NEXT_PUBLIC_* values are baked in at build time.
# "Start matching", VIP trial, invite → the web app (web/).
NEXT_PUBLIC_WEB_APP_URL=https://app.vibe.fawadiqbal.dev
# "Get the app" / "Android" / "Get Vibe for Android" → Play Store listing or a direct .apk.
NEXT_PUBLIC_ANDROID_URL=https://play.google.com/store/apps/details?id=com.example.vibe
# The Vibe API (same value as web/). The hero pill reads the live online count
# from GET <API>/v1/stats/online; leave empty to always show the fallback.
NEXT_PUBLIC_VIBE_API=https://api.vibe.fawadiqbal.dev
NEXT_PUBLIC_ONLINE_FALLBACK=2743
# Public site address, for canonical/OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://vibe.fawadiqbal.dev
# Footer links (default: the FAQ section).
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_SUPPORT_URL=
