# Vibe landing page — static files from `next build` (output: "export"), served by nginx.
# NEXT_PUBLIC_* values are inlined at build time: pass them as build args.
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
ARG NEXT_PUBLIC_WEB_APP_URL
ARG NEXT_PUBLIC_ANDROID_URL
ARG NEXT_PUBLIC_ANDROID_PACKAGE=com.pingcrood.vibe_app
ARG NEXT_PUBLIC_VIBE_API
ARG NEXT_PUBLIC_ONLINE_FALLBACK=2743
ARG NEXT_PUBLIC_SITE_URL
ARG NEXT_PUBLIC_TERMS_URL=""
ARG NEXT_PUBLIC_PRIVACY_URL=""
ARG NEXT_PUBLIC_SUPPORT_URL=""
ARG NEXT_PUBLIC_BRAND_NAME=Vibe
ARG NEXT_PUBLIC_BRAND_LEGAL_NAME=""
ARG NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
ARG NEXT_PUBLIC_BING_SITE_VERIFICATION=""
ARG NEXT_PUBLIC_YANDEX_VERIFICATION=""
ARG NEXT_PUBLIC_GA_ID=""
ARG NEXT_PUBLIC_SOCIAL_LINKS=""
ARG NEXT_PUBLIC_TWITTER_HANDLE=""
ARG NEXT_PUBLIC_SUPPORT_EMAIL=""
ENV NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_WEB_APP_URL=$NEXT_PUBLIC_WEB_APP_URL NEXT_PUBLIC_ANDROID_URL=$NEXT_PUBLIC_ANDROID_URL NEXT_PUBLIC_ANDROID_PACKAGE=$NEXT_PUBLIC_ANDROID_PACKAGE \
    NEXT_PUBLIC_VIBE_API=$NEXT_PUBLIC_VIBE_API NEXT_PUBLIC_ONLINE_FALLBACK=$NEXT_PUBLIC_ONLINE_FALLBACK \
    NEXT_PUBLIC_SITE_URL=$NEXT_PUBLIC_SITE_URL NEXT_PUBLIC_TERMS_URL=$NEXT_PUBLIC_TERMS_URL \
    NEXT_PUBLIC_PRIVACY_URL=$NEXT_PUBLIC_PRIVACY_URL NEXT_PUBLIC_SUPPORT_URL=$NEXT_PUBLIC_SUPPORT_URL \
    NEXT_PUBLIC_BRAND_NAME=$NEXT_PUBLIC_BRAND_NAME NEXT_PUBLIC_BRAND_LEGAL_NAME=$NEXT_PUBLIC_BRAND_LEGAL_NAME \
    NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=$NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION \
    NEXT_PUBLIC_BING_SITE_VERIFICATION=$NEXT_PUBLIC_BING_SITE_VERIFICATION \
    NEXT_PUBLIC_YANDEX_VERIFICATION=$NEXT_PUBLIC_YANDEX_VERIFICATION NEXT_PUBLIC_GA_ID=$NEXT_PUBLIC_GA_ID \
    NEXT_PUBLIC_SOCIAL_LINKS=$NEXT_PUBLIC_SOCIAL_LINKS NEXT_PUBLIC_TWITTER_HANDLE=$NEXT_PUBLIC_TWITTER_HANDLE \
    NEXT_PUBLIC_SUPPORT_EMAIL=$NEXT_PUBLIC_SUPPORT_EMAIL
COPY . .
RUN npm run build

FROM nginx:1.29-alpine AS run
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html
EXPOSE 3003
HEALTHCHECK --interval=30s --timeout=3s CMD wget -qO- http://127.0.0.1:3003/ >/dev/null || exit 1
