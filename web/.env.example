# Where the Vibe API lives (the NestJS backend in ../backend). REST is under
# /v1, Socket.IO connects to the root. Add this web app's origin to the
# backend's CORS_ORIGINS (or leave it at "*" in development).
NEXT_PUBLIC_VIBE_API=https://api.vibe.fawadiqbal.dev

# Google sign-in on the web (Google Identity Services). Use a "Web application"
# OAuth client and add the same id to the backend's GOOGLE_CLIENT_IDS.
# Leave empty to hide the Google button (unless dev sign-in is on).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Development only: offer social buttons that send `dev:` tokens, which a
# backend in dev mode accepts (the Flutter app's debug builds do the same).
NEXT_PUBLIC_DEV_SIGN_IN=yes

# Testing the TURN relay: every call goes through TURN. Never on in production.
NEXT_PUBLIC_FORCE_RELAY=false
