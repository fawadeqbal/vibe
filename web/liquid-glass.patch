+    backdrop-filter: blur(14px) saturate(160%);
+    box-shadow: inset 0 1px 1px rgb(255 255 255 / 0.1);
+  }
+  /* The lighter lozenge that marks the selected tab / segment. */
+  .glass-lens {
+    background-color: rgb(255 255 255 / 0.11);
