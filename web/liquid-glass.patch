+/* ── glass (iOS "Liquid Glass") ─────────────────────────────────────────
+ * Four materials, all with the same specular rim (a 1px ring that is bright
+ * top-left and bottom-right, like light catching a lens edge):
+ *   .glass        cards and grouped lists on a screen
+ *   .glass-thick  sheets, dialogs, menus (must stay readable over anything)
+ *   .glass-bar    the floating tab bar / rail
+ *   .glass-clear  pills and buttons floating over video
+ *   .glass-rim    the rim alone, for gradient-filled tiles
+ * The rim is an absolutely positioned ::before, so the element must be
+ * positioned (relative / absolute / fixed / sticky). `bg-*` utilities
+ * override the fill (utilities beat this layer).
+ */
+@layer components {
+  .glass,
+  .glass-thick,
+  .glass-bar,
+  .glass-clear,
+  .glass-lens,
+  .glass-rim {
+    --rim: linear-gradient(
+      155deg,
+      rgb(255 255 255 / 0.42),
+      rgb(255 255 255 / 0.1) 28%,
+      rgb(255 255 255 / 0.03) 55%,
+      rgb(255 255 255 / 0.08) 78%,
+      rgb(255 255 255 / 0.24)
+    );
+  }
+  .glass::before,
+  .glass-thick::before,
+  .glass-bar::before,
+  .glass-clear::before,
+  .glass-lens::before,
+  .glass-rim::before {
+    content: "";
+    position: absolute;
+    inset: 0;
+    z-index: 1;
+    border-radius: inherit;
+    padding: 1px;
+    background: var(--rim);
+    -webkit-mask:
+      linear-gradient(#000 0 0) content-box,
+      linear-gradient(#000 0 0);
+    -webkit-mask-composite: xor;
+    mask-composite: exclude;
+    pointer-events: none;
+  }
+  .glass {
+    background-color: transparent;
+    background-image: linear-gradient(180deg, rgb(255 255 255 / 0.085), rgb(255 255 255 / 0.035));
+    backdrop-filter: blur(16px) saturate(170%);
+    box-shadow:
+      inset 0 1px 1px rgb(255 255 255 / 0.06),
+      0 12px 32px -14px rgb(0 0 0 / 0.55);
+  }
+  .glass-thick {
+    background-color: rgb(30 26 42 / 0.66);
+    background-image: linear-gradient(180deg, rgb(255 255 255 / 0.07), rgb(255 255 255 / 0));
+    backdrop-filter: blur(24px) saturate(190%);
+    box-shadow:
+      inset 0 1px 1px rgb(255 255 255 / 0.08),
